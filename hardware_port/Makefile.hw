# Makefile.hw - 硬件移植编译（Luckfox Pico Zero）
CROSS_COMPILE = arm-rockchip830-linux-uclibcgnueabihf-
CC = $(CROSS_COMPILE)g++
# AR = $(CROSS_COMPILE)ar  # 不需要，已注释

# 目录
SRC_DIR = .
BUILD_DIR = build_hw
TARGET = mda_player_hw

# ALSA 配置（板端自带，使用动态链接）
CFLAGS = -std=c++17 -O2 -Wall -I$(SRC_DIR)
LDFLAGS = -lasound -lm -lpthread

# 源文件列表（补全所有依赖）
SOURCES = $(SRC_DIR)/mdaEPiano.cpp \
          $(SRC_DIR)/MdaEPianoEngine.cpp \
          $(SRC_DIR)/main_hw.cpp \
          $(SRC_DIR)/MidiParser.cpp

OBJECTS = $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(SOURCES))

all: $(BUILD_DIR) $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "✅ 编译成功: $(TARGET)"

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

deploy: $(TARGET)
	scp $(TARGET) root@192.168.1.100:/tmp/
	@echo "✅ 已部署到板子"

.PHONY: all clean deploy